---
import "../styles/layout.css";
import "../styles/style.css";
import { Translator, type Language } from "../ts/translator";

interface Props {
  title: string;
  description: string;
  lang: Language;
}
const { title, description, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const translator = new Translator(lang);

const pathname = Astro.url.pathname.replace(/\/$/, "");
const isActive = (path: string) => {
  const href = translator.route(path, base).replace(/\/$/, "");
  return path === "" ? pathname === href : pathname.startsWith(href);
};

const siteName = "Sergio Mulet Alonso";
const otherLang: Language = lang === "es" ? "en" : "es";
const urlFor = (l: Language) =>
  new URL(Astro.url.pathname.replace(`/${lang}/`, `/${l}/`), Astro.site).href;
const canonicalUrl = urlFor(lang);
const imageUrl = new URL(`${base}/og-image.jpg`, Astro.site).href;
const imageAlt = `${siteName} - ${translator.getLabel("role")}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      http-equiv="Content-Security-Policy"
      content="
      default-src 'self'; 
      script-src 'self' 'unsafe-inline'; 
      style-src 'self' 'unsafe-inline'; 
      img-src 'self' data:; 
      connect-src 'self'; 
      font-src 'self'; 
      object-src 'none'; 
      base-uri 'self'; 
      form-action 'self';"
    />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={otherLang} href={urlFor(otherLang)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <h1>
        <a
          href={translator.route("", base)}
          title={translator.getLabel("home")}
        >
          Sergio Mulet Alonso
        </a>
      </h1>
      <nav>
        <a
          href={translator.route("", base)}
          title={translator.getLabel("about")}
          class:list={[{ active: isActive("") }]}
          >{translator.getLabel("about")}</a
        >
        <a
          href={translator.route("experience", base)}
          title={translator.getLabel("exp")}
          class:list={[{ active: isActive("experience") }]}
          >{translator.getLabel("exp")}</a
        >
        <a
          href={translator.route("projects", base)}
          title={translator.getLabel("projects")}
          class:list={[{ active: isActive("projects") }]}
          >{translator.getLabel("projects")}</a
        >
        <section>
          <button
            data-lang="es"
            style={`--flag-url: url('${base}/flags/flag_es.svg')`}
            title="Cambiar a Español"
          >
          </button>
          <button
            data-lang="en"
            style={`--flag-url: url('${base}/flags/flag_en.svg')`}
            title="Switch to English"
          >
          </button>
        </section>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        © {new Date().getFullYear()} - Sergio Mulet Alonso - {
          translator.getLabel("role")
        } - <a
          href="https://github.com/SergioMulet/portfolio"
          target="_blank"
          rel="noopener noreferrer"
          >{lang === "es" ? "Ver código fuente" : "View source code"}</a
        >
      </p>
    </footer>
    <script>
      import { LanguageSwitcher } from "../ts/languageSwitcher";
      LanguageSwitcher.init();
    </script>
  </body>
</html>
