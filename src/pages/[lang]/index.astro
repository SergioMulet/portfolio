---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import content from "../../data/content.json";
import type { Language } from "../../ts/translator";
import profilePhoto from "../../assets/sergio_mulet.webp";
import abarthPhoto from "../../assets/abarth.webp";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params as { lang: Language };
const pageInfo = content[lang];
---

<BaseLayout
  title={pageInfo.siteTitle.home}
  description={pageInfo.siteDescription.home}
  lang={lang}
>
  <section>
    <h2>{pageInfo.home.aboutTitle}</h2>
    <article>
      <h3>{pageInfo.home.aboutMe}</h3>
      {pageInfo.home.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </article>
    <article class="contact-article">
      <h3>{pageInfo.home.contactTitle}</h3>
      <ul>
        <li>
          {pageInfo.home.contactLabels.github}:
          <a
            href="https://github.com/SergioMulet"
            target="_blank"
            rel="noopener noreferrer">github.com/SergioMulet</a
          >
        </li>
        <li>
          {pageInfo.home.contactLabels.linkedin}:
          <a
            href="https://linkedin.com/in/sergio-mulet-alonso"
            target="_blank"
            rel="noopener noreferrer"
            >https://linkedin.com/in/sergio-mulet-alonso</a
          >
        </li>
        <li>
          {pageInfo.home.contactLabels.email}:
          <a href="mailto:sergiokma15@gmail.com">sergiokma15@gmail.com</a>
        </li>
        <li>
          {pageInfo.home.contactLabels.phone}:
          <a href="tel:+34684639102">+34 684 639 102</a>
        </li>
      </ul>
      <Image
        src={profilePhoto}
        alt={pageInfo.home.profileAlt}
        width={800}
        widths={[256, 512, 800]}
        sizes="(max-width: 800px) 100vw, 8rem"
        loading="eager"
      />
    </article>

    <article>
      <h2>{pageInfo.home.passionTitle}</h2>
      <p>{pageInfo.home.passionParagraph}</p>
      <Image
        src={abarthPhoto}
        alt={pageInfo.home.abarthAlt}
        widths={[480, 800, 1236]}
        sizes="(max-width: 800px) 100vw, 60vw"
      />
    </article>
  </section>
</BaseLayout>
