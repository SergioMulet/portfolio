---
import BaseLayout from "../../layouts/BaseLayout.astro";
import content from "../../data/content.json";
import type { Language } from "../../ts/translator";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params as { lang: Language };
const pageInfo = content[lang];

interface ExperienceItem {
  role: string;
  period: string;
  startDatetime: string;
  endDatetime?: string;
  description: string;
  bullets: string[];
  repoUrl?: string;
  stackList: string;
}
const items: ExperienceItem[] = pageInfo.experience.items;

function renderMarkdown(text: string) {
  return text.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
}
---

<BaseLayout
  title={pageInfo.siteTitle.experience}
  description={pageInfo.siteDescription.experience}
  lang={lang}
>
  <section>
    <h2>{pageInfo.experience.title}</h2>

    {
      items.map((item) => (
        <article>
          <h3>{item.role}</h3>
          <p class="date">
            <time datetime={item.startDatetime}>
              {item.period.split(" — ")[0]}
            </time>
            {" — "}
            {item.endDatetime ? (
              <time datetime={item.endDatetime}>
                {item.period.split(" — ")[1]}
              </time>
            ) : (
              pageInfo.experience.present
            )}
          </p>

          <p set:html={renderMarkdown(item.description)} />

          <ul>
            {item.bullets.map((bullet) => (
              <li set:html={renderMarkdown(bullet)} />
            ))}
          </ul>

          {item.repoUrl && (
            <p>
              <a href={item.repoUrl} target="_blank" rel="noopener noreferrer">
                {pageInfo.experience.viewRepo}
              </a>
            </p>
          )}
          <p class="stack-list">
            <strong>{pageInfo.experience.stack}:</strong> {item.stackList}
          </p>
        </article>
      ))
    }
  </section>
</BaseLayout>
